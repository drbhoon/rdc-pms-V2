generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Role Templates ─────────────────────────────────────────────────────────
// One record per role. questions is a JSONB array:
//   [{ key, label, fieldType: 'rating'|'narrative'|'number'|'date', order }]
model RoleTemplate {
  id           String   @id @default(cuid())
  roleKey      String   @unique
  roleLabel    String
  filename     String? // original Excel filename
  questions    Json     @default("[]") // [{question_key, question_label, field_type, display_order}]
  profileCols  Json? // [{key, label, field_type}] — employee profile columns
  rmNameCol    String? // header that holds reviewer (RM/BM) name
  rmEmailCol   String? // header that holds reviewer email
  bhNameCol    String? // header that holds approver (BH) name
  bhEmailCol   String? // header that holds approver email
  includeSelf  Boolean  @default(false) // when true, every pair launched against this template gets a self-assessment step before RM
  // Template flavour. STANDARD = Self(opt)→RM→BH→HR (RM/BH rate the same questions).
  // FEEDBACK = employee-only; finalises after Self, HR downloads an employee-wise report.
  // OJT      = segmented questions (Employee / RM_ / BH_ prefixes), each role fills its own.
  templateType String   @default("STANDARD")
  // ── V2: post-BH commenter stages (HR_SPOC → HR_HEAD → COTO) ──────────────
  // These three are COMMENTERS, not assessors. Routing is template-level
  // (same trio for every employee under this template). A stage is "active"
  // iff its field list is non-empty AND its routing email is set.
  hrSpocName   String?
  hrSpocEmail  String?
  hrHeadName   String?
  hrHeadEmail  String?
  cotoName     String?
  cotoEmail    String?
  // Field definitions each commenter fills. Same shape as `questions`:
  //   [{ key, label, fieldType: 'narrative'|'rating'|'select'|'number'|'date', order, options? }]
  hrSpocFields Json?
  hrHeadFields Json?
  cotoFields   Json?
  isActive     Boolean  @default(true) // soft-delete flag: false = hidden from dropdowns, history preserved
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employees Employee[]
  pairs     AssessmentPair[]
}

// ── Employees ──────────────────────────────────────────────────────────────
// Uploaded via Excel. Extra profile columns stored in profileData JSONB.
model Employee {
  id          String   @id @default(cuid())
  empCode     String
  empName     String
  roleKey     String
  email       String? // EMP_EMAIL from Excel — used for self-assessment invites
  // Cycle this row was last uploaded for. Retagged on every re-upload of the
  // same empCode. Cycle Management's launch candidates are filtered to an
  // exact match on this field — a cycle is a fresh, explicit selection of
  // people, not a persistent roster that resurfaces in every later cycle.
  // Null on rows uploaded before this field existed; those never match a
  // cycle filter, so they simply stop appearing as launch candidates (their
  // pair history in whichever cycle they were actually launched in is
  // unaffected — see getEmployeesForCycleManagement).
  cycle       String?
  profileData Json     @default("{}")
  // Where this record came from, and therefore which screen owns it.
  //   'hris'   — pulled from the ZingHR employee master by Launch from Master.
  //              Cycle Management must NOT offer these: it launches per cycle
  //              off a plain employee list, so the same person reappears as
  //              launchable the moment a different cycle is selected.
  //   'manual' — uploaded on the Employees tab. Third party and off-roll staff
  //              who are not in ZingHR at all; Cycle Management is their only
  //              route, so they stay launchable there.
  // Defaults to 'manual' so every existing upload keeps working untouched.
  source      String   @default("manual")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role  RoleTemplate     @relation(fields: [roleKey], references: [roleKey])
  pairs AssessmentPair[]

  @@unique([empCode, roleKey])
}

// ── Assessment Pairs ───────────────────────────────────────────────────────
// One pair = one complete RM+BH assessment cycle for an employee.
// Answers stored as JSONB — fully dynamic, no schema change when questions change.
model AssessmentPair {
  id              String     @id @default(cuid())
  pairId          String     @unique
  empCode         String
  empName         String
  roleKey         String
  cycle           String
  rmName          String
  rmEmail         String
  bhName          String
  bhEmail         String
  status          PairStatus @default(PENDING_RM)
  lockStatus      LockStatus @default(UNLOCKED)
  selectedBy      String?
  selectedOn      DateTime?
  rmSubmittedOn   DateTime?
  bhSubmittedOn   DateTime?
  lastUpdatedBy   String?
  lastUpdatedOn   DateTime?
  rmToken         String     @unique @default(cuid())
  bhToken         String     @unique @default(cuid())
  rmAnswers       Json?
  bhAnswers       Json?
  // Self-assessment branch — only populated when requireSelf=true at launch.
  // Snapshot of RoleTemplate.includeSelf at the moment HR clicked Launch, so
  // toggling the template later doesn't retro-affect in-flight pairs.
  requireSelf     Boolean    @default(false)
  // Snapshot of the template flavour at launch (STANDARD | FEEDBACK | OJT) so
  // later template edits don't retro-affect in-flight pairs. FEEDBACK pairs
  // finalise immediately after the Self submission.
  templateType    String     @default("STANDARD")
  // Snapshot of whether this pair has a Reporting Manager. When an employee has
  // no RM_NAME/RM_EMAIL at launch, requireRm=false: the RM stage is skipped, RM
  // ratings stay blank, and the pair is created directly at RM_SUBMITTED so it
  // routes straight to BH. Existing/in-flight pairs default to true.
  requireRm       Boolean    @default(true)
  selfToken       String?    @unique @default(cuid())
  selfEmail       String? // captured at launch from Employee.email
  selfName        String? // typically empName — kept for future override
  selfAnswers     Json?
  selfSubmittedOn DateTime?
  selfInvitedOn   DateTime?
  isArchived      Boolean    @default(false)
  archivedOn      DateTime?
  archivedBy      String?
  startOn         DateTime? // if null, starts immediately; else cron fires invites on/after this date
  rmInvitedOn     DateTime? // when the RM dashboard email was sent (null until sent)
  bhInvitedOn     DateTime? // when the BH dashboard email was sent
  // ── V2: snapshot of which post-BH commenter stages this pair runs.
  // Captured at launch from the template so toggling the template later
  // doesn't retro-affect in-flight pairs. The actual commenter data lives
  // in the separate HrReview table (one row per active stage).
  // What this pair was launched with: { questions, hrSpocFields, hrHeadFields,
  // cotoFields }. Templates are editable in place, so the forms and reports
  // read this copy — an edit changes the NEXT launch, never one in flight.
  // Null on pairs launched before snapshots existed; those read the template.
  templateSnapshot Json?
  requireHrSpoc   Boolean    @default(false)
  requireHrHead   Boolean    @default(false)
  requireCoto     Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  role      RoleTemplate @relation(fields: [roleKey], references: [roleKey])
  employee  Employee     @relation(fields: [empCode, roleKey], references: [empCode, roleKey])
  logs      AuditLog[]
  hrReviews HrReview[]
}

// ── HR Review (V2) ───────────────────────────────────────────────────────────
// The separate "HR Table". One row per (pair, commenter role). Pre-created at
// launch for each ACTIVE stage so the token exists before the invite email
// goes out. These are view-only commenters on the assessment — they never edit
// self/rm/bh answers; they only fill their own `fields`.
model HrReview {
  id          String    @id @default(cuid())
  pairId      String
  role        String // 'HR_SPOC' | 'HR_HEAD' | 'COTO'
  name        String? // snapshot of template routing name at launch
  email       String? // snapshot of template routing email at launch
  token       String    @unique @default(cuid()) // unique public form URL
  fields      Json? // filled values, keyed by field key from the template
  submittedOn DateTime?
  invitedOn   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pair AssessmentPair @relation(fields: [pairId], references: [pairId])

  @@unique([pairId, role])
  @@index([pairId])
  @@index([email])
}

// ── Reviewer Link ──────────────────────────────────────────────────────────
// One persistent link per (email, role=RM|BH, roleKey, cycle).
// Used to give an RM/BH a single dashboard URL regardless of how many
// assessments they have in the cycle.
model ReviewerLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  email     String
  role      String // "RM" or "BH"
  roleKey   String
  cycle     String
  createdAt DateTime @default(now())

  @@unique([email, role, roleKey, cycle])
  @@index([email])
}

// ── Audit Log ──────────────────────────────────────────────────────────────
model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  action      String
  pairId      String?
  empCode     String?
  empName     String?
  roleKey     String?
  cycle       String?
  performedBy String
  details     Json?

  pair AssessmentPair? @relation(fields: [pairId], references: [pairId])
}

// ── HR Users ───────────────────────────────────────────────────────────────
model HrUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      HrRole   @default(HR_ADMIN)
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum PairStatus {
  PENDING_SELF
  PENDING_RM
  RM_SUBMITTED
  PENDING_BH
  // ── V2: post-BH commenter stages. The pair sits in <ROLE>_SUBMITTED while
  // it awaits the NEXT commenter. e.g. BH_SUBMITTED = BH done, awaiting HR_SPOC.
  BH_SUBMITTED
  HR_SPOC_SUBMITTED
  HR_HEAD_SUBMITTED
  FINALIZED
}

enum LockStatus {
  UNLOCKED
  LOCKED
}

enum HrRole {
  HR_ADMIN
  HR_SUPER_ADMIN
}

// ── Polls ──────────────────────────────────────────────────────────────────
// A short vote among a group of people — best presentation, team leader, and
// the like. Deliberately NOT an assessment: no reviewer chain, no cycle, no
// employee/template link. One e-mail each, one vote each, results as Excel.
//
// Votes are NOT secret, by decision: the results name who voted for whom, so a
// contested result can be checked. Say so on the voting page.
model Poll {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      PollStatus @default(DRAFT)
  // Both ways of ending it: a closing date, and a Close now button. Whichever
  // comes first wins — see pollIsOpen().
  closesAt    DateTime?
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions    PollQuestion[]
  participants PollParticipant[]
}

model PollQuestion {
  id       String  @id @default(cuid())
  pollId   String
  order    Int
  text     String
  // SINGLE_CHOICE | MULTI_CHOICE | RATING_1_5 | SHORT_TEXT
  type     String  @default("SINGLE_CHOICE")
  // PARTICIPANTS = the options ARE the people in this poll (vote for a person,
  // never yourself). LIST = the options typed below.
  optionSource String @default("LIST")
  options  Json?
  maxChoices Int?
  required Boolean @default(true)

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, order])
  @@index([pollId])
}

// One row per invited person: their link, and their answers once they vote.
// Answers live here rather than in their own table because a person votes
// once — that is the rule, and one row per voter is what enforces it.
model PollParticipant {
  id          String    @id @default(cuid())
  pollId      String
  empCode     String
  name        String
  email       String
  token       String    @unique @default(cuid())
  invitedOn   DateTime?
  respondedOn DateTime?
  answers     Json?

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, empCode])
  @@index([pollId])
  @@index([email])
}

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
}
